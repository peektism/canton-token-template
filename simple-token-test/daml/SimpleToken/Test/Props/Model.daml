-- | Pure state-machine model of canton-network-token-standard simple-token.
-- Models the transfer logic from SimpleToken/Rules.daml without Script effects.
-- Parties are represented as Int indices: 0=admin, 1=alice, 2=bob, 3=charlie.
--
-- Design: The executor returns Right state (unchanged) for invalid preconditions
-- (e.g., insufficient funds). Left is only returned for true invariant violations.
-- This matches Echidna/Foundry semantics: invalid actions are no-ops.
module SimpleToken.Test.Props.Model where

import DamlProps.Gen

-- | Number of parties in the model.
numParties : Int
numParties = 4

-- | A holding: (ownerIdx, amount).
type Holding = (Int, Decimal)

-- | A locked holding: (ownerIdx, amount, lockId).
type LockedHolding = (Int, Decimal, Int)

-- | A pending transfer instruction: (senderIdx, receiverIdx, amount, instrId).
type PendingInstruction = (Int, Int, Decimal, Int)

-- | The ledger state as a pure value.
data TokenState = TokenState with
  holdings : [Holding]
  locked : [LockedHolding]
  pending : [PendingInstruction]
  nextId : Int
  initialSupply : Decimal
    deriving (Show, Eq)

-- | Create initial state: one party holds the full supply.
mkInitialState : Decimal -> Int -> TokenState
mkInitialState supply ownerIdx = TokenState
  [(ownerIdx, supply)]
  []
  []
  1
  supply

-- | Actions that can be performed on the token state.
data TokenAction
  = SelfTransfer with stSender : Int; stAmount : Decimal
  | DirectTransfer with dtSender : Int; dtReceiver : Int; dtAmount : Decimal
  | TwoStepInitiate with tsInitSender : Int; tsInitReceiver : Int; tsInitAmount : Decimal
  | TwoStepAccept with tsaInstrId : Int
  | TwoStepReject with tsrInstrId : Int
  | TwoStepWithdraw with tswInstrId : Int
    deriving (Show, Eq)

-- | V2 iterated-settlement model for one authorizer and one receiver.
-- Tracks the accounting shape implemented by SimpleAllocationV2:
-- locked reserve + net credit/debit -> authorizer payout + next reserve.
data IteratedSettlementState = IteratedSettlementState with
  authorizerUnlocked : Decimal
  authorizerLocked : Decimal
  receiverUnlocked : Decimal
  activeAllocationId : Optional Int
  nextAllocationId : Int
  consumedAllocationIds : [Int]
  settledIterations : Int
  acceptedSettlementAmount : Decimal
  rejectedRepeatedSettlements : Int
  iteratedInitialSupply : Decimal
    deriving (Show, Eq)

mkIteratedSettlementState : Decimal -> IteratedSettlementState
mkIteratedSettlementState reserve =
  IteratedSettlementState with
    authorizerUnlocked = 0.0
    authorizerLocked = reserve
    receiverUnlocked = 0.0
    activeAllocationId = Some 1
    nextAllocationId = 2
    consumedAllocationIds = []
    settledIterations = 0
    acceptedSettlementAmount = 0.0
    rejectedRepeatedSettlements = 0
    iteratedInitialSupply = reserve

data IteratedSettlementAction
  = IteratedPartialSettlement with ipsAmount : Decimal; ipsNextFunding : Decimal
  | IteratedFinalize
  | IteratedCancel
  | IteratedWithdraw
  | IteratedStaleReplay with
      isrTargetAllocationId : Int
      isrAmount : Decimal
      isrNextFunding : Decimal
    deriving (Show, Eq)

-- | Get total holdings for a party.
partyBalance : Int -> TokenState -> Decimal
partyBalance idx state =
  let held = foldl (\acc (o, a) -> if o == idx then acc + a else acc) 0.0 state.holdings
      lock = foldl (\acc (o, a, _) -> if o == idx then acc + a else acc) 0.0 state.locked
  in held + lock

-- | Get unlocked holdings for a party.
partyHoldings : Int -> TokenState -> [Holding]
partyHoldings idx state =
  filter (\(o, _) -> o == idx) state.holdings

-- | Total supply across all holdings and locked holdings.
-- Pending instructions don't add supply — they reference the same value as locked holdings.
totalSupply : TokenState -> Decimal
totalSupply state =
  let held = foldl (\acc (_, a) -> acc + a) 0.0 state.holdings
      lock = foldl (\acc (_, a, _) -> acc + a) 0.0 state.locked
  in held + lock

-- | Execute a token action. Invalid preconditions → Right state (no-op).
-- Only returns Left for true invariant violations (bugs in the model).
executeTokenAction : TokenState -> TokenAction -> Either Text TokenState
executeTokenAction state (SelfTransfer sender amount) =
  let senderHlds = partyHoldings sender state
      senderTotal = foldl (\acc (_, a) -> acc + a) 0.0 senderHlds
  in
  -- Precondition checks → no-op on failure
  if amount <= 0.0 then Right state
  else if null senderHlds then Right state
  else if senderTotal < amount then Right state
  else
    let remaining = filter (\(o, _) -> o /= sender) state.holdings
        change = senderTotal - amount
        newHoldings = if change > 0.0
                      then (sender, amount) :: (sender, change) :: remaining
                      else (sender, amount) :: remaining
    in Right state with holdings = newHoldings

executeTokenAction state (DirectTransfer sender receiver amount) =
  let senderHlds = partyHoldings sender state
      senderTotal = foldl (\acc (_, a) -> acc + a) 0.0 senderHlds
  in
  if amount <= 0.0 then Right state
  else if sender == receiver then Right state
  else if null senderHlds then Right state
  else if senderTotal < amount then Right state
  else
    let remaining = filter (\(o, _) -> o /= sender) state.holdings
        change = senderTotal - amount
        newHoldings = (receiver, amount)
                   :: (if change > 0.0 then [(sender, change)] else [])
                   <> remaining
    in Right state with holdings = newHoldings

executeTokenAction state (TwoStepInitiate sender receiver amount) =
  let senderHlds = partyHoldings sender state
      senderTotal = foldl (\acc (_, a) -> acc + a) 0.0 senderHlds
  in
  if amount <= 0.0 then Right state
  else if sender == receiver then Right state
  else if null senderHlds then Right state
  else if senderTotal < amount then Right state
  else
    let remaining = filter (\(o, _) -> o /= sender) state.holdings
        change = senderTotal - amount
        instrId = state.nextId
        newLocked = (sender, amount, instrId) :: state.locked
        newPending = (sender, receiver, amount, instrId) :: state.pending
        newHoldings = if change > 0.0
                      then (sender, change) :: remaining
                      else remaining
    in Right state with
        holdings = newHoldings
        locked = newLocked
        pending = newPending
        nextId = state.nextId + 1

executeTokenAction state (TwoStepAccept instrId) =
  case findPending instrId state.pending of
    None -> Right state  -- no-op: instruction doesn't exist
    Some (_, receiver, amount, _) ->
      let newPending = filter (\(_, _, _, i) -> i /= instrId) state.pending
          newLocked = filter (\(_, _, i) -> i /= instrId) state.locked
          newHoldings = (receiver, amount) :: state.holdings
      in Right state with
          holdings = newHoldings
          locked = newLocked
          pending = newPending

executeTokenAction state (TwoStepReject instrId) =
  case findPending instrId state.pending of
    None -> Right state
    Some (sender, _, amount, _) ->
      let newPending = filter (\(_, _, _, i) -> i /= instrId) state.pending
          newLocked = filter (\(_, _, i) -> i /= instrId) state.locked
          newHoldings = (sender, amount) :: state.holdings
      in Right state with
          holdings = newHoldings
          locked = newLocked
          pending = newPending

executeTokenAction state (TwoStepWithdraw instrId) =
  case findPending instrId state.pending of
    None -> Right state
    Some (sender, _, amount, _) ->
      let newPending = filter (\(_, _, _, i) -> i /= instrId) state.pending
          newLocked = filter (\(_, _, i) -> i /= instrId) state.locked
          newHoldings = (sender, amount) :: state.holdings
      in Right state with
          holdings = newHoldings
          locked = newLocked
          pending = newPending

executeIteratedSettlementAction
  : IteratedSettlementState
  -> IteratedSettlementAction
  -> Either Text IteratedSettlementState
executeIteratedSettlementAction state (IteratedPartialSettlement amount nextFunding) =
  case state.activeAllocationId of
    None -> Right state
    Some allocationId ->
      if amount <= 0.0 then Right state
      else if nextFunding <= 0.0 then Right state
      else
        let available = state.authorizerLocked - amount
        in if available < nextFunding then Right state
           else
            let successorId = state.nextAllocationId
            in Right state with
              authorizerUnlocked = state.authorizerUnlocked + available - nextFunding
              authorizerLocked = nextFunding
              receiverUnlocked = state.receiverUnlocked + amount
              activeAllocationId = Some successorId
              nextAllocationId = successorId + 1
              consumedAllocationIds = allocationId :: state.consumedAllocationIds
              settledIterations = state.settledIterations + 1
              acceptedSettlementAmount = state.acceptedSettlementAmount + amount

executeIteratedSettlementAction state IteratedFinalize =
  closeIteratedAllocation state

executeIteratedSettlementAction state IteratedCancel =
  closeIteratedAllocation state

executeIteratedSettlementAction state IteratedWithdraw =
  closeIteratedAllocation state

executeIteratedSettlementAction state (IteratedStaleReplay targetAllocationId _ _) =
  if targetAllocationId `elem` state.consumedAllocationIds
  then Right state with
      rejectedRepeatedSettlements = state.rejectedRepeatedSettlements + 1
  else Right state

closeIteratedAllocation : IteratedSettlementState -> Either Text IteratedSettlementState
closeIteratedAllocation state =
  case state.activeAllocationId of
    None -> Right state
    Some allocationId -> Right state with
      authorizerUnlocked = state.authorizerUnlocked + state.authorizerLocked
      authorizerLocked = 0.0
      activeAllocationId = None
      consumedAllocationIds = allocationId :: state.consumedAllocationIds

-- | Find a pending instruction by ID.
findPending : Int -> [PendingInstruction] -> Optional PendingInstruction
findPending _ [] = None
findPending targetId ((s, r, a, i) :: rest) =
  if i == targetId then Some (s, r, a, i)
  else findPending targetId rest

-- | Check all invariants on the token state.
checkTokenInvariants : TokenState -> Either Text ()
checkTokenInvariants state =
  let supply = totalSupply state
  in if supply /= state.initialSupply
     then Left ("Conservation violated: expected=" <> show state.initialSupply
               <> " actual=" <> show supply)
  else
    let negHoldings = filter (\(_, a) -> a <= 0.0) state.holdings
        negLocked = filter (\(_, a, _) -> a <= 0.0) state.locked
    in if not (null negHoldings)
       then Left ("Non-positive holding: " <> show negHoldings)
    else if not (null negLocked)
       then Left ("Non-positive locked holding: " <> show negLocked)
    else checkPartyBalances 0 state

-- | Check non-negative per-party balances.
checkPartyBalances : Int -> TokenState -> Either Text ()
checkPartyBalances idx state
  | idx >= numParties = Right ()
  | otherwise =
    let bal = partyBalance idx state
    in if bal < 0.0
       then Left ("Negative balance for party " <> show idx <> ": " <> show bal)
       else checkPartyBalances (idx + 1) state

totalIteratedSettlementSupply : IteratedSettlementState -> Decimal
totalIteratedSettlementSupply state =
  state.authorizerUnlocked + state.authorizerLocked + state.receiverUnlocked

checkIteratedSettlementInvariants : IteratedSettlementState -> Either Text ()
checkIteratedSettlementInvariants state =
  if totalIteratedSettlementSupply state /= state.iteratedInitialSupply
  then Left
    ("V2 iterated conservation violated: expected="
      <> show state.iteratedInitialSupply
      <> " actual="
      <> show (totalIteratedSettlementSupply state))
  else if state.authorizerUnlocked < 0.0 || state.authorizerLocked < 0.0 || state.receiverUnlocked < 0.0
  then Left ("V2 iterated negative balance: " <> show state)
  else if state.receiverUnlocked /= state.acceptedSettlementAmount
  then Left ("V2 iterated receiver balance does not match accepted settlement total: " <> show state)
  else if not (uniqueInts state.consumedAllocationIds)
  then Left ("V2 iterated consumed allocation ids are not unique: " <> show state)
  else if not (all (\cid -> cid < state.nextAllocationId) state.consumedAllocationIds)
  then Left ("V2 iterated consumed allocation id is outside issued range: " <> show state)
  else case state.activeAllocationId of
    Some allocationId ->
      if allocationId `elem` state.consumedAllocationIds
      then Left ("V2 iterated active allocation id was already consumed: " <> show state)
      else if allocationId >= state.nextAllocationId
      then Left ("V2 iterated active allocation id is outside issued range: " <> show state)
      else if state.authorizerLocked <= 0.0
      then Left ("V2 iterated active allocation has no positive reserve: " <> show state)
      else Right ()
    None ->
      if state.authorizerLocked /= 0.0
      then Left ("V2 iterated closed allocation still has locked reserve: " <> show state)
      else Right ()

uniqueInts : [Int] -> Bool
uniqueInts values = case values of
  [] -> True
  value :: rest -> not (value `elem` rest) && uniqueInts rest

-- | Generate a random token action.
genTokenAction : Gen TokenAction
genTokenAction = genOneOf
  [ genSelfTransfer
  , genDirectTransfer
  , genTwoStepInitiate
  , genTwoStepAccept
  , genTwoStepReject
  , genTwoStepWithdraw
  ]

genSelfTransfer : Gen TokenAction
genSelfTransfer =
  genBind (genInt 1 (numParties - 1)) $ \sender ->
  genBind (genDecimal 0.0000000001 500.0) $ \amount ->
  genPure (SelfTransfer sender amount)

genDirectTransfer : Gen TokenAction
genDirectTransfer =
  genBind (genInt 1 (numParties - 1)) $ \sender ->
  genBind (genInt 1 (numParties - 1)) $ \receiver ->
  genBind (genDecimal 0.0000000001 500.0) $ \amount ->
  if sender == receiver
  then genPure (SelfTransfer sender amount)
  else genPure (DirectTransfer sender receiver amount)

genTwoStepInitiate : Gen TokenAction
genTwoStepInitiate =
  genBind (genInt 1 (numParties - 1)) $ \sender ->
  genBind (genInt 1 (numParties - 1)) $ \receiver ->
  genBind (genDecimal 0.0000000001 500.0) $ \amount ->
  if sender == receiver
  then genPure (SelfTransfer sender amount)
  else genPure (TwoStepInitiate sender receiver amount)

genTwoStepAccept : Gen TokenAction
genTwoStepAccept =
  genBind (genInt 0 20) $ \instrId ->
  genPure (TwoStepAccept instrId)

genTwoStepReject : Gen TokenAction
genTwoStepReject =
  genBind (genInt 0 20) $ \instrId ->
  genPure (TwoStepReject instrId)

genTwoStepWithdraw : Gen TokenAction
genTwoStepWithdraw =
  genBind (genInt 0 20) $ \instrId ->
  genPure (TwoStepWithdraw instrId)

genIteratedSettlementAction : Gen IteratedSettlementAction
genIteratedSettlementAction = genFrequency
  [ (6, genIteratedPartialSettlement)
  , (1, genPure IteratedFinalize)
  , (1, genPure IteratedCancel)
  , (1, genPure IteratedWithdraw)
  , (2, genIteratedStaleReplay)
  ]

genIteratedPartialSettlement : Gen IteratedSettlementAction
genIteratedPartialSettlement =
  genBind (genDecimal 0.0000000001 50.0) $ \amount ->
  genBind (genDecimal 0.0000000001 100.0) $ \nextFunding ->
  genPure (IteratedPartialSettlement amount nextFunding)

genIteratedStaleReplay : Gen IteratedSettlementAction
genIteratedStaleReplay =
  genBind (genInt 0 20) $ \targetAllocationId ->
  genBind (genDecimal 0.0000000001 50.0) $ \amount ->
  genBind (genDecimal 0.0000000001 100.0) $ \nextFunding ->
  genPure
    (IteratedStaleReplay with
      isrTargetAllocationId = targetAllocationId
      isrAmount = amount
      isrNextFunding = nextFunding)
