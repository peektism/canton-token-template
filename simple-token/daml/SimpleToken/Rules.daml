-- | SimpleTokenRules: the factory contract implementing TransferFactory and AllocationFactory.
-- Supports multiple instruments via supportedInstruments list.
-- Implements 3-way transfer dispatch: self-transfer, direct (preapproval), two-step (lock+instruction).
module SimpleToken.Rules where

import DA.TextMap qualified as TextMap
import DA.Optional (isNone)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.TransferInstructionV1
import Splice.Api.Token.TransferInstructionV2 qualified as TransferV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationV2 qualified as AllocationV2
import Splice.Api.Token.AllocationInstructionV1
import Splice.Api.Token.AllocationInstructionV2 qualified as AllocationInstructionV2
import Splice.TokenStandard.Utils qualified as TokenStandard

import SimpleToken.Holding
import SimpleToken.Preapproval
import SimpleToken.TransferInstruction
import SimpleToken.Allocation
import SimpleToken.Supply (MintProposal(..))
import SimpleToken.ContextUtils
import SimpleToken.Reporting (recordHoldingsChangeEvent)
import SimpleToken.Experimental.Cip112.Account
  ( accountAuthority
  , accountObservers
  , accountPrincipal
  , assertSupportedRegularAccount
  , isBasicAccount
  , isSupportedRegularAccount
  )
import SimpleToken.Admin.Capability (RoleCapability, requireRole, consumeMintAllowance)
import SimpleToken.Admin.Errors
  ( eRegistryPaused, eRedundantPauseChange, eMintAmountNotPositive
  , eCappedMinterRequiresPreapproval
  , eAccountFrozen, eAccountAlreadyFrozen, eAccountNotFrozen, eCannotFreezeAdmin
  )
import SimpleToken.Admin.Roles (Role(..))

-- | Result of `Rules_Mint`. Exactly one of `mintedHoldingCids` (direct path, via
-- the recipient's preapproval) or `pendingProposalCid` (cold-recipient path, via
-- a `MintProposal` the recipient accepts) is populated. `minterCapCid` is the
-- caller's `Minter` capability, possibly rotated if its D3 allowance was decremented.
data Rules_MintResult = Rules_MintResult with
    mintedHoldingCids : [ContractId Holding]
    pendingProposalCid : Optional (ContractId MintProposal)
    minterCapCid : ContractId RoleCapability

-- | Pausable guard: the OpenZeppelin `whenNotPaused` analogue. Fails the
-- transaction when the registry is paused.
--
-- Pause is ORIGINATION control: it is checked at the factory chokepoints that
-- *originate* value movement (new transfers, new allocations, factory-driven
-- batch settlement) before any state mutation. It deliberately does NOT gate
-- completion of already-committed flows (accepting a pending transfer, settling
-- a committed allocation) — those are protected by committed-settlement /
-- counterparty semantics, and in a keyless UTXO ledger their contracts cannot
-- read the factory flag without a spoofable context hop anyway. Recovery
-- (withdraw / reject / cancel) also stays open so funds are never frozen
-- (INV-33). A per-account compliance *freeze* is a separate capability (AL-10,
-- `assertAccountsNotFrozen` + `Rules_FreezeAccount`), deliberately not conflated
-- with the registry-wide pause. See docs/ADMIN-LAYER-PLAN.md §4 and §6.
assertNotPaused : Bool -> Update ()
assertNotPaused paused = assertMsg eRegistryPaused (not paused)

-- | Account-freeze guard (AL-10): the per-account analogue of `assertNotPaused`.
-- Fails the transaction if ANY of the given parties is on the registry's
-- `frozenAccounts` list. Checked at the same origination chokepoints as pause,
-- against sender AND receiver (and the mint recipient), so a frozen account can
-- neither send nor receive — the OFAC/AML compliance hold (INV-40).
--
-- It is non-spoofable for the same reason pause is: `frozenAccounts` is a field on
-- the `SimpleTokenRules` contract being exercised, not a caller-supplied lookup
-- (Daml LF 2.1 has no global registry; a caller-passed blocklist would be omittable
-- — correction C2). The freeze is realized by the registry admin withholding its
-- required signature at the factory, never a public on-ledger blocklist (privacy).
assertAccountsNotFrozen : [Party] -> [Party] -> Update ()
assertAccountsNotFrozen frozenAccounts parties =
  assertMsg eAccountFrozen (all (`notElem` frozenAccounts) parties)

-- | Experimental V2 actor guard marker used before delegating into the V1 factory.
v2TransferFactoryActorFailureMsg : Text
v2TransferFactoryActorFailureMsg =
  "SimpleToken V2 TransferFactory: actors must equal the basic sender owner before V1 delegation"

v2ProviderManagedTransferFactoryActorFailureMsg : Text
v2ProviderManagedTransferFactoryActorFailureMsg =
  "SimpleToken V2 provider-managed TransferFactory: actors must equal sender account authority"

-- | Experimental V2 actor guard marker used before creating an allocation instruction.
v2AllocationFactoryActorFailureMsg : Text
v2AllocationFactoryActorFailureMsg =
  "SimpleToken V2 AllocationFactory: actors must equal the account authority"

-- | Experimental V2 actor guard marker used before batch settlement delegation.
v2SettlementFactoryActorFailureMsg : Text
v2SettlementFactoryActorFailureMsg =
  "SimpleToken V2 SettlementFactory_SettleBatch: actors must equal settlement executors"

-- | Experimental V2 account guard marker used before batch settlement delegation.
v2SettlementFactoryBasicAccountFailureMsg : Text
v2SettlementFactoryBasicAccountFailureMsg =
  "SimpleToken V2 SettlementFactory_SettleBatch: transfer-leg accounts must be supported regular accounts"

-- | The factory contract for creating transfers and allocations.
-- Single instance supports multiple instrument IDs.
template SimpleTokenRules
  with
    admin : Party
    supportedInstruments : [Text]
    paused : Bool  -- ^ Pausable flag; when True all gated factory choices revert.
    frozenAccounts : [Party]
      -- ^ AL-10 account-level compliance hold: parties on this list are refused at
      -- every origination chokepoint (as sender, receiver, or mint recipient).
      -- Maintained by `Rules_FreezeAccount`/`Rules_UnfreezeAccount` (registry-wide
      -- `ComplianceAdmin`-gated); duplicate-free by the non-idempotent guards.
  where
    signatory admin

    -- | Flip the pause flag. The actor must present a registry-wide `Pauser`
    -- capability issued by this registry's admin. Recreates the factory with the
    -- new flag; the contract's own admin authority lets a non-admin pauser
    -- perform the recreate, while the capability check gates who may do so.
    --
    -- # Invariants enforced:
    -- - INV-26: pausing/unpausing requires a registry-wide Pauser capability
    choice Rules_SetPaused : ContractId SimpleTokenRules
      with
        actor : Party                       -- ^ The party flipping the flag.
        pauserCap : ContractId RoleCapability -- ^ The actor's registry-wide Pauser capability.
        newPaused : Bool                    -- ^ Target pause state.
      controller actor
      do
        -- Pausing is registry-wide, so it requires a registry-wide (scope None)
        -- Pauser capability; an instrument-scoped Pauser cannot halt the registry.
        requireRole actor Pauser admin None pauserCap
        -- INV-26: must change state (OZ Pausable semantics), avoiding no-op churn.
        assertMsg eRedundantPauseChange (newPaused /= paused)
        create this with paused = newPaused

    -- | Read the pause flag without archiving. Read-only and ungated so wallets
    -- can display registry state even while paused (INV-34). The actor must have
    -- the factory disclosed to exercise it (the off-ledger service provides this).
    nonconsuming choice Rules_GetPaused : Bool
      with actor : Party  -- ^ The querying party.
      controller actor
      do pure paused

    -- | Place an account on a compliance hold (AL-10). The actor must present a
    -- registry-wide `ComplianceAdmin` capability issued by this registry's admin —
    -- freeze is registry-wide (a sanctioned party is held across every instrument),
    -- so an instrument-scoped capability cannot freeze, exactly as pause requires a
    -- registry-wide `Pauser`. Recreates the factory with `account` added to
    -- `frozenAccounts`.
    --
    -- This is a MANUAL administrative action (AL-9 OQ-2): the controller is a human
    -- holding the capability; nothing here fires automatically from an oracle, claim
    -- expiry, or timer. Freeze is reversible, so a single `ComplianceAdmin` officer
    -- suffices (irreversible seizure — AL-11 — will require two-person control). The
    -- `reason` is recorded in the exercise node, giving an immutable on-ledger audit
    -- trail of why the hold was placed.
    --
    -- # Invariants enforced:
    -- - INV-41: freezing requires a registry-wide ComplianceAdmin capability
    -- - INV-42: the admin cannot be frozen; an already-frozen account is rejected
    choice Rules_FreezeAccount : ContractId SimpleTokenRules
      with
        actor : Party                            -- ^ The party placing the hold.
        complianceCap : ContractId RoleCapability -- ^ The actor's registry-wide ComplianceAdmin capability.
        account : Party                          -- ^ The account to freeze.
        reason : Text                            -- ^ Audit metadata: why the hold is placed.
      controller actor
      do
        _ <- requireRole actor ComplianceAdmin admin None complianceCap
        assertMsg eCannotFreezeAdmin (account /= admin)
        assertMsg eAccountAlreadyFrozen (account `notElem` frozenAccounts)
        create this with frozenAccounts = account :: frozenAccounts

    -- | Lift a compliance hold (AL-10). Same registry-wide `ComplianceAdmin` gate as
    -- `Rules_FreezeAccount`; rejects unfreezing an account that is not held. `reason`
    -- is again recorded for the audit trail.
    --
    -- # Invariants enforced:
    -- - INV-41: unfreezing requires a registry-wide ComplianceAdmin capability
    -- - INV-42: an account that is not frozen is rejected
    choice Rules_UnfreezeAccount : ContractId SimpleTokenRules
      with
        actor : Party                            -- ^ The party lifting the hold.
        complianceCap : ContractId RoleCapability -- ^ The actor's registry-wide ComplianceAdmin capability.
        account : Party                          -- ^ The account to unfreeze.
        reason : Text                            -- ^ Audit metadata: why the hold is lifted.
      controller actor
      do
        _ <- requireRole actor ComplianceAdmin admin None complianceCap
        assertMsg eAccountNotFrozen (account `elem` frozenAccounts)
        create this with frozenAccounts = filter (/= account) frozenAccounts

    -- | Read the frozen-account set without archiving. Read-only and ungated so
    -- wallets/auditors can display compliance state (the INV-34 analogue for freeze).
    nonconsuming choice Rules_GetFrozenAccounts : [Party]
      with actor : Party  -- ^ The querying party.
      controller actor
      do pure frozenAccounts

    -- | Mint new supply to `recipient` (AL-5). Gated by the caller's `Minter`
    -- capability (instrument-scoped) and its D3 allowance. Mint is origination, so
    -- it is `whenNotPaused`. A3 dispatch: if `recipient` has a `TransferPreapproval`
    -- (supplied in `extraArgs.context`), the holding is created directly; otherwise
    -- a `MintProposal` is emitted for the recipient to accept (Canton requires the
    -- recipient's authority to create their holding). The advisory `TotalSupply`
    -- (D2) is reconciled off-ledger from the resulting create event, not here.
    --
    -- # Invariants enforced:
    -- - INV-25: blocked while paused
    -- - INV-35: positive amount, supported instrument, instrument admin == registry admin
    -- - INV-36: D3 allowance enforced + decremented via `consumeMintAllowance`
    nonconsuming choice Rules_Mint : Rules_MintResult
      with
        minter : Party                        -- ^ The Minter-capability holder.
        minterCap : ContractId RoleCapability -- ^ The caller's Minter capability.
        recipient : Party                     -- ^ Party to receive the minted holding.
        amount : Decimal                      -- ^ Amount to mint.
        instrumentId : InstrumentId           -- ^ Instrument to mint.
        extraArgs : ExtraArgs                 -- ^ Carries the recipient preapproval (if any) + meta.
      controller minter
      do
        assertNotPaused paused
        -- INV-40: cannot mint into a frozen account (compliance hold on the recipient)
        assertAccountsNotFrozen frozenAccounts [recipient]
        assertMsg eMintAmountNotPositive (amount > 0.0)
        assertMsg "instrumentId.admin must match factory admin"
          (instrumentId.admin == admin)
        assertMsg "Instrument not supported by this factory"
          (instrumentId.id `elem` supportedInstruments)
        -- A3 dispatch: direct mint via the recipient's preapproval, else propose.
        optPreapprovalCid <- lookupFromContextU @(ContractId TransferPreapproval)
          extraArgs.context transferPreapprovalContextKey
        case optPreapprovalCid of
          Some preapprovalCid -> do
            -- Direct path: the holding is created atomically in THIS transaction, so
            -- the D3 allowance can be enforced and decremented atomically here.
            newCapCid <- consumeMintAllowance minter admin (Some instrumentId) amount minterCap
            preapproval <- fetch preapprovalCid
            assertMsg "Preapproval admin does not match factory admin"
              (preapproval.admin == admin)
            assertMsg "Preapproval receiver does not match mint recipient"
              (preapproval.receiver == recipient)
            holdingCid <- exercise preapprovalCid TransferPreapproval_MintInto with
              mintInstrumentId = instrumentId
              amount
              holdingMeta = extraArgs.meta
            pure Rules_MintResult with
              mintedHoldingCids = [holdingCid]
              pendingProposalCid = None
              minterCapCid = newCapCid
          None -> do
            -- Proposal (cold-recipient) path: the holding is created later, in the
            -- recipient's accept transaction. Because that splits the mint across two
            -- transactions controlled by different parties, the D3 allowance cannot be
            -- enforced/decremented atomically — so this path is restricted to
            -- UNLIMITED minters (no allowance to enforce or leak). A capped minter
            -- must mint atomically via the recipient's preapproval. The Minter
            -- capability is still validated; it is not consumed (None ⇒ no rotation).
            cap <- requireRole minter Minter admin (Some instrumentId) minterCap
            assertMsg eCappedMinterRequiresPreapproval (isNone cap.mintAllowance)
            proposalCid <- create MintProposal with
              admin
              recipient
              instrumentId
              amount
              meta = extraArgs.meta
            pure Rules_MintResult with
              mintedHoldingCids = []
              pendingProposalCid = Some proposalCid
              minterCapCid = minterCap

    interface instance TransferFactory for SimpleTokenRules where
      view = TransferFactoryView with
        admin
        meta = emptyMetadata

      transferFactory_transferImpl _selfCid arg = do
        -- INV-25: Pausable guard, before any validation or state mutation
        assertNotPaused paused
        let transfer = arg.transfer
        -- INV-40: account-freeze guard — neither sender nor receiver may be on a hold
        assertAccountsNotFrozen frozenAccounts [transfer.sender, transfer.receiver]
        -- Invariant #1: expectedAdmin matches admin
        assertMsg "expectedAdmin does not match factory admin"
          (arg.expectedAdmin == admin)
        -- Invariant #6: amount > 0
        assertMsg "Transfer amount must be positive"
          (transfer.amount > 0.0)
        -- Invariant #2: requestedAt <= ledgerTime
        now <- getTime
        assertMsg "requestedAt must not be in the future"
          (transfer.requestedAt <= now)
        -- Invariant #3: executeBefore > ledgerTime
        assertMsg "executeBefore must be in the future"
          (transfer.executeBefore > now)
        -- Invariant #7: instrumentId.admin == admin
        assertMsg "instrumentId.admin must match factory admin"
          (transfer.instrumentId.admin == admin)
        -- Multi-instrument support (Gap 7): check instrument is supported
        assertMsg "Instrument not supported by this factory"
          (transfer.instrumentId.id `elem` supportedInstruments)
        -- Invariant #8: non-empty inputHoldingCids
        assertMsg "inputHoldingCids must not be empty"
          (not $ null transfer.inputHoldingCids)

        -- Invariant #9: archive ALL inputs (first mutation for contention guarantee)
        -- Also validate each input: owner, instrumentId, lock status (invariants #10, #17, #19, #20)
        totalInput <- archiveAndSumInputs transfer.sender transfer.instrumentId transfer.inputHoldingCids

        -- Invariant #18: sum(inputs) >= amount (Gap 3)
        assertMsg ("Insufficient funds: have " <> show totalInput <> " but need " <> show transfer.amount)
          (totalInput >= transfer.amount)

        -- 3-way dispatch
        if transfer.sender == transfer.receiver then
          -- Self-transfer path (merge/defragment)
          selfTransfer admin transfer totalInput arg.extraArgs
        else do
          -- Check for preapproval in context
          optPreapprovalCid <- lookupFromContextU @(ContractId TransferPreapproval) arg.extraArgs.context transferPreapprovalContextKey
          case optPreapprovalCid of
            Some preapprovalCid ->
              -- Direct transfer path
              directTransfer admin transfer totalInput preapprovalCid arg.extraArgs
            None ->
              -- Two-step transfer path
              twoStepTransfer admin transfer totalInput arg.extraArgs

      transferFactory_publicFetchImpl _selfCid arg = do
        assertMsg "expectedAdmin does not match factory admin"
          (arg.expectedAdmin == admin)
        pure TransferFactoryView with admin; meta = emptyMetadata

    interface instance TransferV2.TransferFactory for SimpleTokenRules where
      view = TransferV2.TransferFactoryView with
        admin
        meta = emptyMetadata

      transferFactory_transferExtraObservers =
        TokenStandard.transferFactoryV2_privateAsset_transferExtraObserversDefaultImpl

      transferFactory_transferImpl selfCid arg = do
        -- INV-25: Pausable guard (V2 path)
        assertNotPaused paused
        -- INV-40: account-freeze guard — check the owning principals of both accounts
        -- (`accountPrincipal` resolves basic and provider-managed accounts alike).
        assertAccountsNotFrozen frozenAccounts
          [ accountPrincipal admin arg.transfer.sender
          , accountPrincipal admin arg.transfer.receiver ]
        if isBasicAccount arg.transfer.sender && isBasicAccount arg.transfer.receiver
          then do
            let sender = TokenStandard.accountPrincipal arg.transfer.instrumentId.admin arg.transfer.sender
            assertMsg v2TransferFactoryActorFailureMsg (arg.actors == [sender])
            TokenStandard.transferFactory_v2_senderActor_transferImpl selfCid arg
          else
            providerManagedTransfer admin supportedInstruments arg

      transferFactory_publicFetchImpl _selfCid _arg = do
        pure TransferV2.TransferFactoryView with admin; meta = emptyMetadata

    interface instance TransferEventsV2.EventLog for SimpleTokenRules where
      view = TransferEventsV2.EventLogView with
        admin
        meta = emptyMetadata

      eventLog_holdingsChangeImpl =
        \_selfCid arg -> do
          _ <- recordHoldingsChangeEvent admin [] arg
          pure TransferEventsV2.EventLog_HoldingsChangeResult

    interface instance AllocationFactory for SimpleTokenRules where
      view = AllocationFactoryView with
        admin
        meta = emptyMetadata

      allocationFactory_allocateImpl _selfCid arg = do
        -- INV-25: Pausable guard (V1 allocation path)
        assertNotPaused paused
        let leg = arg.allocation.transferLeg
            settlement = arg.allocation.settlement
        -- INV-40: account-freeze guard — neither sender nor receiver may be on a hold
        assertAccountsNotFrozen frozenAccounts [leg.sender, leg.receiver]
        -- Invariant #1: expectedAdmin matches admin
        assertMsg "expectedAdmin does not match factory admin"
          (arg.expectedAdmin == admin)
        -- Invariant #6: amount > 0
        assertMsg "Allocation amount must be positive"
          (leg.amount > 0.0)
        -- Invariant #2: requestedAt <= ledgerTime
        now <- getTime
        assertMsg "requestedAt must not be in the future"
          (arg.requestedAt <= now)
        -- Invariant #4: allocateBefore > ledgerTime
        assertMsg "allocateBefore must be in the future"
          (settlement.allocateBefore > now)
        -- Invariant #5: allocateBefore <= settleBefore
        assertMsg "allocateBefore must be <= settleBefore"
          (settlement.allocateBefore <= settlement.settleBefore)
        -- Invariant #7: instrumentId.admin == admin
        assertMsg "instrumentId.admin must match factory admin"
          (leg.instrumentId.admin == admin)
        -- Multi-instrument support
        assertMsg "Instrument not supported by this factory"
          (leg.instrumentId.id `elem` supportedInstruments)
        -- Invariant #8: non-empty inputHoldingCids
        assertMsg "inputHoldingCids must not be empty"
          (not $ null arg.inputHoldingCids)

        -- Archive all inputs and sum amounts
        totalInput <- archiveAndSumInputs leg.sender leg.instrumentId arg.inputHoldingCids

        -- Invariant #18: sufficient funds
        assertMsg ("Insufficient funds: have " <> show totalInput <> " but need " <> show leg.amount)
          (totalInput >= leg.amount)

        -- Create locked holding for the allocation
        lockedCid <- create LockedSimpleHolding with
          admin
          owner = leg.sender
          instrumentId = leg.instrumentId
          amount = leg.amount
          lock = Lock with
            holders = [admin]
            expiresAt = Some settlement.settleBefore
            expiresAfter = None
            context = Some "allocation"
          extraObservers = [settlement.executor, leg.receiver]
          meta = emptyMetadata

        -- Create the allocation (direct-to-completed)
        allocationCid <- create SimpleAllocation with
          admin
          allocation = arg.allocation
          lockedHoldingCid = lockedCid

        -- Create sender change if needed
        senderChangeCids <- if totalInput > leg.amount
          then do
            changeCid <- create SimpleHolding with
              admin
              owner = leg.sender
              instrumentId = leg.instrumentId
              amount = totalInput - leg.amount
              meta = emptyMetadata
            pure [toInterfaceContractId @Holding changeCid]
          else pure []

        pure AllocationInstructionResult with
          output = AllocationInstructionResult_Completed with
            allocationCid = toInterfaceContractId @Allocation allocationCid
          senderChangeCids
          meta = txKindMeta "transfer"

      allocationFactory_publicFetchImpl _selfCid arg = do
        assertMsg "expectedAdmin does not match factory admin"
          (arg.expectedAdmin == admin)
        pure AllocationFactoryView with admin; meta = emptyMetadata

    interface instance AllocationInstructionV2.AllocationFactory for SimpleTokenRules where
      view = AllocationInstructionV2.AllocationFactoryView with
        admin
        meta = emptyMetadata

      allocationFactory_allocateExtraObservers =
        TokenStandard.allocationFactoryV2_privateAsset_allocateExtraObserversDefaultImpl

      allocationFactory_allocateImpl _selfCid arg = do
        -- INV-25: Pausable guard (V2 allocation path)
        assertNotPaused paused
        let allocation = arg.allocation
        -- INV-40: account-freeze guard — the authorizer and every leg counterparty
        assertAccountsNotFrozen frozenAccounts
          (accountPrincipal admin allocation.authorizer
            :: map (\s -> accountPrincipal admin s.otherside) allocation.transferLegSides)
        assertMsg "V2 allocation admin must match factory admin"
          (allocation.admin == admin)
        now <- getTime
        assertMsg "V2 allocation requestedAt must not be in the future"
          (arg.requestedAt <= now)
        assertV2NextIterationFunding supportedInstruments allocation.nextIterationFunding
        assertMsg "V2 allocation specification is malformed or unsupported"
          (TokenStandard.isValidAllocationSpecificationV2
            (\instrumentId -> instrumentId `elem` supportedInstruments)
            allocation)
        assertSupportedRegularAccount "allocation.authorizer" allocation.authorizer
        _ <- mapA (\leg ->
          assertSupportedRegularAccount "allocation.transferLegSide.otherside" leg.otherside)
          allocation.transferLegSides
        let authorizer = accountAuthority admin allocation.authorizer
        assertMsg v2AllocationFactoryActorFailureMsg (arg.actors == [authorizer])
        inputHoldingCidMap <- v2AllocationInputCidMap arg.inputHoldingCids
        allocationLockViewPolicy <- allocationLockViewPolicyFromContext arg.extraArgs.context
        instrCid <- create SimpleAllocationInstructionV2 with
          admin
          supportedInstruments
          allocation
          requestedAt = arg.requestedAt
          inputHoldingCids = arg.inputHoldingCids
          inputHoldingCidMap
          originalInstructionCid = None
          allocationLockViewPolicy
        pure AllocationInstructionV2.AllocationInstructionResult with
          output = AllocationInstructionV2.AllocationInstructionResult_Pending with
            allocationInstructionCid =
              toInterfaceContractId @AllocationInstructionV2.AllocationInstruction instrCid
          authorizerChangeCids = TextMap.empty
          meta = emptyMetadata

      allocationFactory_publicFetchImpl _selfCid _arg = do
        pure AllocationInstructionV2.AllocationFactoryView with admin; meta = emptyMetadata

    interface instance AllocationV2.SettlementFactory for SimpleTokenRules where
      view = AllocationV2.SettlementFactoryView with
        admin
        meta = emptyMetadata

      settlementFactory_settleBatchExtraObservers =
        TokenStandard.settlementFactoryV2_privateAsset_settleBatchExtraObserversDefaultImpl

      settlementFactory_settleBatchImpl selfCid arg = do
        -- INV-25: Pausable guard (V2 settlement path)
        assertNotPaused paused
        -- INV-40: account-freeze guard — every transfer-leg principal being settled.
        -- Like pause, this gates batch ORIGINATION (the new direct transfer legs); it
        -- does not reach into already-committed `arg.allocations` (committed-flow
        -- completion is out of scope for freeze, as for pause — see §4 of the docs).
        assertAccountsNotFrozen frozenAccounts
          (concatMap
            (\leg -> [accountPrincipal admin leg.sender, accountPrincipal admin leg.receiver])
            arg.transferLegs)
        assertMsg v2SettlementFactoryActorFailureMsg
          (samePartySet arg.settlement.executors arg.actors)
        assertMsg "V2 settlement transfer legs or allocations must not be empty"
          (not (null arg.transferLegs) || not (null arg.allocations))
        _ <- mapA (\leg -> do
          assertMsg "V2 settlement transfer amount must be positive"
            (leg.amount > 0.0)
          assertMsg "V2 settlement instrument not supported by this factory"
            (leg.instrumentId `elem` supportedInstruments)
          assertMsg v2SettlementFactoryBasicAccountFailureMsg
            (isSupportedTransferLegAccount leg.sender && isSupportedTransferLegAccount leg.receiver)
          pure ()) arg.transferLegs
        let eventLogCid = coerceInterfaceContractId selfCid : ContractId TransferEventsV2.EventLog
        TokenStandard.settlementFactoryV2_settleBatchDefaultImpl admin selfCid
          (arg with extraArgs = withEventLogContext eventLogCid arg.extraArgs)

      settlementFactory_publicFetchImpl _selfCid _arg = do
        pure AllocationV2.SettlementFactoryView with admin; meta = emptyMetadata


-- Internal implementation functions
-------------------------------------

isSupportedTransferLegAccount : HoldingV2.Account -> Bool
isSupportedTransferLegAccount = isSupportedRegularAccount

providerManagedTransfer
  : Party
  -> [Text]
  -> TransferV2.TransferFactory_Transfer
  -> Update TransferV2.TransferInstructionResult
providerManagedTransfer admin supportedInstruments arg = do
  let transfer = arg.transfer
      senderAuthority = accountAuthority admin transfer.sender
  assertSupportedRegularAccount "transfer.sender" transfer.sender
  assertSupportedRegularAccount "transfer.receiver" transfer.receiver
  assertMsg v2ProviderManagedTransferFactoryActorFailureMsg
    (arg.actors == [senderAuthority])
  assertMsg "V2 provider-managed transfer amount must be positive"
    (transfer.amount > 0.0)
  now <- getTime
  assertMsg "V2 provider-managed transfer requestedAt must not be in the future"
    (transfer.requestedAt <= now)
  assertMsg "V2 provider-managed transfer executeBefore must be in the future"
    (transfer.executeBefore > now)
  assertMsg "V2 provider-managed transfer instrument admin must match factory admin"
    (transfer.instrumentId.admin == admin)
  assertMsg "V2 provider-managed transfer instrument not supported by this factory"
    (transfer.instrumentId.id `elem` supportedInstruments)
  assertMsg "V2 provider-managed transfer inputHoldingCids must not be empty"
    (not $ null transfer.inputHoldingCids)

  totalInput <- archiveAndSumV2Inputs
    transfer.sender
    transfer.instrumentId
    transfer.inputHoldingCids
  assertMsg
    ("Insufficient V2 provider-managed transfer funds: have "
      <> show totalInput
      <> " but need "
      <> show transfer.amount)
    (totalInput >= transfer.amount)

  if transfer.sender == transfer.receiver
    then do
      receiverCid <- createSupportedV2Holding
        admin
        transfer.receiver
        transfer.instrumentId
        transfer.amount
        arg.extraArgs.meta
      senderChangeCids <- if totalInput > transfer.amount
        then do
          changeCid <- createSupportedV2Holding
            admin
            transfer.sender
            transfer.instrumentId
            (totalInput - transfer.amount)
            emptyMetadata
          pure [changeCid]
        else pure []
      pure TransferV2.TransferInstructionResult with
        output = TransferV2.TransferInstructionResult_Completed with
          receiverHoldingCids = [receiverCid]
        senderChangeCids
        meta = txKindMeta "merge-split"
    else do
      lockedCid <- createSupportedV2LockedHolding
        admin
        transfer.sender
        transfer.instrumentId
        transfer.amount
        (Lock with
          holders = [admin, senderAuthority]
          expiresAt = Some transfer.executeBefore
          expiresAfter = None
          context = Some "provider-managed-pending-transfer")
        (accountObservers transfer.receiver)
        emptyMetadata
      instrCid <- create ProviderManagedTransferInstruction with
        admin
        transfer
        lockedHoldingCid = lockedCid
        originalInstructionCid = None
      senderChangeCids <- if totalInput > transfer.amount
        then do
          changeCid <- createSupportedV2Holding
            admin
            transfer.sender
            transfer.instrumentId
            (totalInput - transfer.amount)
            emptyMetadata
          pure [changeCid]
        else pure []
      pure TransferV2.TransferInstructionResult with
        output = TransferV2.TransferInstructionResult_Pending with
          transferInstructionCid =
            toInterfaceContractId @TransferV2.TransferInstruction instrCid
        senderChangeCids
        meta = txKindMeta "transfer"

-- | Archive all input holdings and return their total amount.
-- Validates per-input: owner, instrumentId, lock status (invariants #10, #17, #19, #20).
archiveAndSumInputs : Party -> InstrumentId -> [ContractId Holding] -> Update Decimal
archiveAndSumInputs sender expectedInstrumentId holdingCids = do
  amounts <- forA holdingCids $ \holdingCid -> do
    holdingI <- fetch holdingCid
    let hv = view holdingI
    -- Invariant #10: input owner == sender
    assertMsg "Input holding owner does not match sender"
      (hv.owner == sender)
    -- Invariant #17: input instrumentId matches transfer instrumentId (Gap 4)
    assertMsg "Input holding instrumentId does not match transfer"
      (hv.instrumentId == expectedInstrumentId)
    -- Invariants #19 and #20: handle locked holdings (Gap 5)
    case hv.lock of
      None -> pure () -- unlocked, fine
      Some lock -> do
        -- Invariant #20: unexpired locks rejected
        -- Invariant #19: expired locks accepted
        now <- getTime
        let lockExpired = case lock.expiresAt of
              None -> False
              Some t -> now >= t
        assertMsg "Cannot use holding with unexpired lock as transfer input"
          lockExpired
    archive holdingCid
    pure hv.amount
  pure (sum amounts)

-- | Self-transfer: merge inputs into one holding + optional change.
selfTransfer : Party -> Transfer -> Decimal -> ExtraArgs -> Update TransferInstructionResult
selfTransfer admin transfer totalInput extraArgs = do
  -- Create single merged holding
  receiverCid <- create SimpleHolding with
    admin
    owner = transfer.sender
    instrumentId = transfer.instrumentId
    amount = transfer.amount
    meta = extraArgs.meta
  -- Change back to sender
  senderChangeCids <- if totalInput > transfer.amount
    then do
      changeCid <- create SimpleHolding with
        admin
        owner = transfer.sender
        instrumentId = transfer.instrumentId
        amount = totalInput - transfer.amount
        meta = emptyMetadata
      pure [toInterfaceContractId @Holding changeCid]
    else pure []
  logCompletedTransferFromContext transfer extraArgs senderChangeCids [toInterfaceContractId @Holding receiverCid]
  pure TransferInstructionResult with
    output = TransferInstructionResult_Completed with
      receiverHoldingCids = [toInterfaceContractId @Holding receiverCid]
    senderChangeCids
    meta = txKindMeta "merge-split"

-- | Direct transfer: preapproval exists, send directly.
-- The preapproval choice creates the receiver holding (needs receiver auth from preapproval signatories).
directTransfer : Party -> Transfer -> Decimal -> ContractId TransferPreapproval -> ExtraArgs -> Update TransferInstructionResult
directTransfer admin transfer totalInput preapprovalCid extraArgs = do
  -- Exercise nonconsuming send on preapproval (validates instrumentId match - invariant #16)
  (receiverHoldingCids, senderChangeCids) <- exercise preapprovalCid TransferPreapproval_Send with
    sender = transfer.sender
    transferInstrumentId = transfer.instrumentId
    amount = transfer.amount
    totalInput
    holdingMeta = extraArgs.meta
  logCompletedTransferFromContext transfer extraArgs senderChangeCids receiverHoldingCids
  pure TransferInstructionResult with
    output = TransferInstructionResult_Completed with
      receiverHoldingCids
    senderChangeCids
    meta = txKindMeta "transfer"

-- | Two-step transfer: create locked holding + transfer instruction.
twoStepTransfer : Party -> Transfer -> Decimal -> ExtraArgs -> Update TransferInstructionResult
twoStepTransfer admin transfer totalInput extraArgs = do
  -- Create locked holding with receiver as observer (Gap 1: extraObservers)
  lockedCid <- create LockedSimpleHolding with
    admin
    owner = transfer.sender
    instrumentId = transfer.instrumentId
    amount = transfer.amount
    lock = Lock with
      holders = [admin]
      expiresAt = Some transfer.executeBefore
      expiresAfter = None
      context = Some "pending-transfer"
    extraObservers = [transfer.receiver]
    meta = emptyMetadata
  instrCid <- create SimpleTransferInstruction with
    admin
    transfer
    lockedHoldingCid = lockedCid
    originalInstructionCid = None
  -- Change back to sender
  senderChangeCids <- if totalInput > transfer.amount
    then do
      changeCid <- create SimpleHolding with
        admin
        owner = transfer.sender
        instrumentId = transfer.instrumentId
        amount = totalInput - transfer.amount
        meta = emptyMetadata
      pure [toInterfaceContractId @Holding changeCid]
    else pure []
  pure TransferInstructionResult with
    output = TransferInstructionResult_Pending with
      transferInstructionCid = toInterfaceContractId @TransferInstruction instrCid
    senderChangeCids
    meta = txKindMeta "transfer"

logCompletedTransferFromContext
  : Transfer
  -> ExtraArgs
  -> [ContractId Holding]
  -> [ContractId Holding]
  -> Update ()
logCompletedTransferFromContext transfer extraArgs senderChangeCids receiverHoldingCids = do
  contextEventLogCid <- lookupFromContextU @(ContractId TransferEventsV2.EventLog)
    extraArgs.context
    eventLogContextKey
  case contextEventLogCid of
    Some logCid ->
      TokenStandard.logTransfer
        logCid
        (TokenStandard.upcast transfer)
        (map TokenStandard.upcast senderChangeCids)
        (map TokenStandard.upcast receiverHoldingCids)
    None -> pure ()
