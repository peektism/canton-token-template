-- | Transfer instruction for two-step transfers.
-- Created when receiver has no preapproval; requires explicit accept/reject/withdraw.
module SimpleToken.TransferInstruction where

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.TransferInstructionV1
import Splice.Api.Token.TransferInstructionV2 qualified as TransferV2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.TokenStandard.Utils qualified as TokenStandard

import DA.Map qualified as Map

import SimpleToken.Holding
import SimpleToken.ContextUtils
import SimpleToken.Experimental.Cip112.Account
  ( accountAuthority
  , accountObservers
  , isProviderManagedRegularAccount
  )

-- | Experimental V2 actor guard markers used before delegating into V1 choices.
v2TransferAcceptActorFailureMsg : Text
v2TransferAcceptActorFailureMsg =
  "SimpleToken V2 TransferInstruction_Accept: actors must equal the receiver owner before V1 delegation"

v2TransferRejectActorFailureMsg : Text
v2TransferRejectActorFailureMsg =
  "SimpleToken V2 TransferInstruction_Reject: actors must equal the receiver owner before V1 delegation"

v2TransferWithdrawActorFailureMsg : Text
v2TransferWithdrawActorFailureMsg =
  "SimpleToken V2 TransferInstruction_Withdraw: actors must equal the sender owner before V1 delegation"

v2ProviderManagedTransferAcceptActorFailureMsg : Text
v2ProviderManagedTransferAcceptActorFailureMsg =
  "SimpleToken V2 provider-managed TransferInstruction_Accept: actors must equal receiver provider"

v2ProviderManagedTransferRejectActorFailureMsg : Text
v2ProviderManagedTransferRejectActorFailureMsg =
  "SimpleToken V2 provider-managed TransferInstruction_Reject: actors must equal receiver provider"

v2ProviderManagedTransferWithdrawActorFailureMsg : Text
v2ProviderManagedTransferWithdrawActorFailureMsg =
  "SimpleToken V2 provider-managed TransferInstruction_Withdraw: actors must equal sender provider"

-- | A pending transfer instruction backed by a locked holding.
template SimpleTransferInstruction
  with
    admin : Party
    transfer : Transfer
    lockedHoldingCid : ContractId LockedSimpleHolding
    originalInstructionCid : Optional (ContractId TransferInstruction)
  where
    signatory admin, transfer.sender
    observer transfer.receiver

    interface instance TransferInstruction for SimpleTransferInstruction where
      view = TransferInstructionView with
        originalInstructionCid
        transfer
        status = TransferPendingReceiverAcceptance
        meta = emptyMetadata

      transferInstruction_acceptImpl selfCid arg = do
        -- Validate deadline before any archival (Gap 8)
        now <- getTime
        assertMsg "Transfer has expired (executeBefore passed)"
          (now < transfer.executeBefore)
        lockedHolding <- fetch lockedHoldingCid
        archive lockedHoldingCid
        let totalInput = lockedHolding.amount
        -- Create receiver holding
        receiverCid <- create SimpleHolding with
          admin
          owner = transfer.receiver
          instrumentId = transfer.instrumentId
          amount = transfer.amount
          meta = arg.extraArgs.meta
        -- Create sender change if needed
        senderChangeCids <- if totalInput > transfer.amount
          then do
            changeCid <- create SimpleHolding with
              admin
              owner = transfer.sender
              instrumentId = transfer.instrumentId
              amount = totalInput - transfer.amount
              meta = emptyMetadata
            pure [toInterfaceContractId @Holding changeCid]
          else pure []
        pure TransferInstructionResult with
          output = TransferInstructionResult_Completed with
            receiverHoldingCids = [toInterfaceContractId @Holding receiverCid]
          senderChangeCids
          meta = txKindMeta "transfer"

      transferInstruction_rejectImpl _selfCid arg = do
        returnLockedFundsToSender admin transfer lockedHoldingCid arg.extraArgs

      transferInstruction_withdrawImpl _selfCid arg = do
        returnLockedFundsToSender admin transfer lockedHoldingCid arg.extraArgs

      transferInstruction_updateImpl _selfCid _arg = do
        fail "TransferInstruction_Update is not supported"

    interface instance TransferV2.TransferInstruction for SimpleTransferInstruction where
      view = TransferV2.TransferInstructionView with
        originalInstructionCid = TokenStandard.upcast <$> originalInstructionCid
        transfer = TokenStandard.upcast transfer
        expiresAt = Some transfer.executeBefore
        availableActions = v2PendingTransferActions transfer.sender transfer.receiver
        meta = emptyMetadata

      transferInstruction_acceptExtraObservers =
        TokenStandard.transferInstruction_acceptDefaultExtraObservers this
      transferInstruction_rejectExtraObservers =
        TokenStandard.transferInstruction_rejectDefaultExtraObservers this
      transferInstruction_withdrawExtraObservers =
        TokenStandard.transferInstruction_withdrawDefaultExtraObservers this

      transferInstruction_acceptImpl selfCid arg = do
        assertMsg v2TransferAcceptActorFailureMsg (arg.actors == [transfer.receiver])
        result <- TokenStandard.transferInstruction_v2_receiverActor_acceptDefaultImplUsingV1
          transfer.receiver selfCid arg
        contextEventLogCid <- lookupFromContextU @(ContractId TransferEventsV2.EventLog)
          arg.extraArgs.context
          eventLogContextKey
        case (contextEventLogCid, result.output) of
          (Some logCid, TransferV2.TransferInstructionResult_Completed receiverHoldingCids) ->
            TokenStandard.logTransfer
              logCid
              (v2TransferForAcceptEvent transfer lockedHoldingCid)
              result.senderChangeCids
              receiverHoldingCids
          _ -> pure ()
        pure result

      transferInstruction_rejectImpl selfCid arg = do
        assertMsg v2TransferRejectActorFailureMsg (arg.actors == [transfer.receiver])
        result <- TokenStandard.transferInstruction_v2_receiverActor_rejectDefaultImplUsingV1
          transfer.receiver selfCid arg
        logReturnedTransferFromContext
          transfer.instrumentId.admin
          (TokenStandard.basicAccount transfer.sender)
          arg.extraArgs
          "reject transfer"
          [toInterfaceContractId @HoldingV2.Holding lockedHoldingCid]
          result.senderChangeCids
        pure result

      transferInstruction_withdrawImpl selfCid arg = do
        assertMsg v2TransferWithdrawActorFailureMsg (arg.actors == [transfer.sender])
        result <- TokenStandard.transferInstruction_v2_senderActor_withdrawDefaultImplUsingV1
          transfer.sender selfCid arg
        logReturnedTransferFromContext
          transfer.instrumentId.admin
          (TokenStandard.basicAccount transfer.sender)
          arg.extraArgs
          "withdraw transfer"
          [toInterfaceContractId @HoldingV2.Holding lockedHoldingCid]
          result.senderChangeCids
        pure result


-- | Experimental CIP-0112 V2 action map for providerless basic accounts only.
v2PendingTransferActions : Party -> Party -> Map.Map TransferV2.TransferInstructionAction [[Party]]
v2PendingTransferActions sender receiver = Map.fromList
  [ (TransferV2.TIA_Withdraw, [[sender]])
  , (TransferV2.TIA_Accept, [[receiver]])
  , (TransferV2.TIA_Reject, [[receiver]])
  ]

v2TransferForAcceptEvent
  : Transfer
  -> ContractId LockedSimpleHolding
  -> TransferV2.Transfer
v2TransferForAcceptEvent transfer lockedHoldingCid =
  (TokenStandard.upcast transfer) with
    inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding lockedHoldingCid]


-- | Helper: archive locked holding and return unlocked holding to sender.
-- Supports the expire-lock pattern: if the locked holding was already archived
-- (owner exercised LockedSimpleHolding_Unlock after lock expiry), the context
-- key "expire-lock" = False signals this, and we return Failed with empty
-- senderChangeCids (funds already returned via Unlock).
returnLockedFundsToSender : Party -> Transfer -> ContractId LockedSimpleHolding -> ExtraArgs -> Update TransferInstructionResult
returnLockedFundsToSender admin transfer lockedHoldingCid extraArgs = do
  let lockedHoldingActive = case lookupFromContext @Bool extraArgs.context expireLockContextKey of
        Right (Some False) -> False
        _ -> True  -- default: assume active (backward compatible)
  if lockedHoldingActive
    then do
      lockedHolding <- fetch lockedHoldingCid
      archive lockedHoldingCid
      returnCid <- create SimpleHolding with
        admin
        owner = transfer.sender
        instrumentId = transfer.instrumentId
        amount = lockedHolding.amount
        meta = emptyMetadata
      pure TransferInstructionResult with
        output = TransferInstructionResult_Failed
        senderChangeCids = [toInterfaceContractId @Holding returnCid]
        meta = txKindMeta "transfer"
    else do
      -- Locked holding already archived by owner. Verify deadline has passed.
      now <- getTime
      assertMsg "Locked holding not active but transfer has not expired"
        (now >= transfer.executeBefore)
      pure TransferInstructionResult with
        output = TransferInstructionResult_Failed
        senderChangeCids = []
        meta = txKindMeta "transfer"


-- | Experimental V2-only transfer instruction for regular provider-managed
-- accounts. Basic-account transfers continue to use SimpleTransferInstruction
-- and V1 delegation.
template ProviderManagedTransferInstruction
  with
    admin : Party
    transfer : TransferV2.Transfer
    lockedHoldingCid : ContractId HoldingV2.Holding
    originalInstructionCid : Optional (ContractId TransferV2.TransferInstruction)
  where
    ensure isProviderManagedRegularAccount transfer.sender || isProviderManagedRegularAccount transfer.receiver
    signatory admin, accountAuthority admin transfer.sender
    observer accountObservers transfer.sender
    observer accountObservers transfer.receiver

    interface instance TransferV2.TransferInstruction for ProviderManagedTransferInstruction where
      view = TransferV2.TransferInstructionView with
        originalInstructionCid
        transfer
        expiresAt = Some transfer.executeBefore
        availableActions =
          v2ProviderManagedTransferActions admin transfer.sender transfer.receiver
        meta = emptyMetadata

      transferInstruction_acceptExtraObservers =
        TokenStandard.transferInstruction_acceptDefaultExtraObservers this
      transferInstruction_rejectExtraObservers =
        TokenStandard.transferInstruction_rejectDefaultExtraObservers this
      transferInstruction_withdrawExtraObservers =
        TokenStandard.transferInstruction_withdrawDefaultExtraObservers this

      transferInstruction_acceptImpl selfCid arg = do
        assertMsg v2ProviderManagedTransferAcceptActorFailureMsg
          (arg.actors == [accountAuthority admin transfer.receiver])
        now <- getTime
        assertMsg "Provider-managed transfer has expired"
          (now < transfer.executeBefore)
        archive (coerceContractId selfCid : ContractId ProviderManagedTransferInstruction)
        lockedHolding <- fetch lockedHoldingCid
        let lockedView = view lockedHolding
        assertMsg "Provider-managed transfer locked input account must match sender"
          (lockedView.account == transfer.sender)
        assertMsg "Provider-managed transfer locked input instrument must match transfer"
          (lockedView.instrumentId == transfer.instrumentId)
        archive lockedHoldingCid
        receiverCid <- createSupportedV2Holding
          admin
          transfer.receiver
          transfer.instrumentId
          transfer.amount
          arg.extraArgs.meta
        senderChangeCids <- if lockedView.amount > transfer.amount
          then do
            changeCid <- createSupportedV2Holding
              admin
              transfer.sender
              transfer.instrumentId
              (lockedView.amount - transfer.amount)
              emptyMetadata
            pure [changeCid]
          else pure []
        contextEventLogCid <- lookupFromContextU @(ContractId TransferEventsV2.EventLog)
          arg.extraArgs.context
          eventLogContextKey
        case contextEventLogCid of
          Some logCid ->
            TokenStandard.logTransfer
              logCid
              (transfer with inputHoldingCids = [lockedHoldingCid])
              senderChangeCids
              [receiverCid]
          None -> pure ()
        pure TransferV2.TransferInstructionResult with
          output = TransferV2.TransferInstructionResult_Completed with
            receiverHoldingCids = [receiverCid]
          senderChangeCids
          meta = txKindMeta "transfer"

      transferInstruction_rejectImpl selfCid arg = do
        assertMsg v2ProviderManagedTransferRejectActorFailureMsg
          (arg.actors == [accountAuthority admin transfer.receiver])
        returnProviderManagedTransferFundsToSender selfCid transfer lockedHoldingCid arg.extraArgs "reject transfer"

      transferInstruction_withdrawImpl selfCid arg = do
        assertMsg v2ProviderManagedTransferWithdrawActorFailureMsg
          (arg.actors == [accountAuthority admin transfer.sender])
        returnProviderManagedTransferFundsToSender selfCid transfer lockedHoldingCid arg.extraArgs "withdraw transfer"

v2ProviderManagedTransferActions
  : Party
  -> HoldingV2.Account
  -> HoldingV2.Account
  -> Map.Map TransferV2.TransferInstructionAction [[Party]]
v2ProviderManagedTransferActions admin sender receiver = Map.fromList
  [ (TransferV2.TIA_Withdraw, [[accountAuthority admin sender]])
  , (TransferV2.TIA_Accept, [[accountAuthority admin receiver]])
  , (TransferV2.TIA_Reject, [[accountAuthority admin receiver]])
  ]

returnProviderManagedTransferFundsToSender
  : ContractId TransferV2.TransferInstruction
  -> TransferV2.Transfer
  -> ContractId HoldingV2.Holding
  -> ExtraArgs
  -> Text
  -> Update TransferV2.TransferInstructionResult
returnProviderManagedTransferFundsToSender selfCid transfer lockedHoldingCid extraArgs reason = do
  archive (coerceContractId selfCid : ContractId ProviderManagedTransferInstruction)
  lockedHolding <- fetch lockedHoldingCid
  let lockedView = view lockedHolding
  assertMsg "Provider-managed transfer locked input account must match sender"
    (lockedView.account == transfer.sender)
  assertMsg "Provider-managed transfer locked input instrument must match transfer"
    (lockedView.instrumentId == transfer.instrumentId)
  archive lockedHoldingCid
  returnCid <- createSupportedV2Holding
    transfer.instrumentId.admin
    transfer.sender
      transfer.instrumentId
      lockedView.amount
      emptyMetadata
  logReturnedTransferFromContext
    transfer.instrumentId.admin
    transfer.sender
    extraArgs
    reason
    [lockedHoldingCid]
    [returnCid]
  pure TransferV2.TransferInstructionResult with
    output = TransferV2.TransferInstructionResult_Failed
    senderChangeCids = [returnCid]
    meta = txKindMeta "transfer"

logReturnedTransferFromContext
  : Party
  -> HoldingV2.Account
  -> ExtraArgs
  -> Text
  -> [ContractId HoldingV2.Holding]
  -> [ContractId HoldingV2.Holding]
  -> Update ()
logReturnedTransferFromContext admin account extraArgs reason inputHoldingCids outputHoldingCids = do
  contextEventLogCid <- lookupFromContextU @(ContractId TransferEventsV2.EventLog)
    extraArgs.context
    eventLogContextKey
  case contextEventLogCid of
    Some logCid ->
      if null outputHoldingCids
        then pure ()
        else TokenStandard.logMergeSplit
          logCid
          admin
          account
          inputHoldingCids
          reason
          outputHoldingCids
    None -> pure ()
