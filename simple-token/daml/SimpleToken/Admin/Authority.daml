-- | Ownable-as-Admin-role: the governance anchor for a registry.
--
-- Design (docs/ADMIN-LAYER-PLAN.md §5): on Canton the instrument `admin` party is
-- baked into every `InstrumentId` and co-signs every holding, so it is the
-- permanent cryptographic root and cannot be reassigned without re-issuing
-- assets. Rather than fake an "ownership transfer" of that party, the admin
-- layer collapses Ownable into AccessControl: the `Admin` role *is* the owner
-- (`DEFAULT_ADMIN_ROLE`). The genesis `admin` party always retains ultimate
-- authority; operational governance is delegated by issuing an `Admin`
-- capability to another party and revoked by archiving it. That delegation —
-- not a party swap — is the ownership-handoff analogue, and it works
-- immediately because every capability is anchored to the same fixed `admin`.
--
-- `TokenAdministrator` is the genesis issuer. It exposes direct issuance/
-- revocation (controlled by the root `admin`) and delegated issuance/revocation
-- (controlled by any holder of a registry-wide `Admin` capability). Delegated
-- choices carry the contract's admin authority, so a delegate can mint/revoke
-- admin-signed capabilities without holding the root key.
module SimpleToken.Admin.Authority where

import Splice.Api.Token.HoldingV1 (InstrumentId)

import SimpleToken.Admin.Capability (RoleCapability(..), requireRole)
import SimpleToken.Admin.Errors
import SimpleToken.Admin.Roles (Role(..))

-- | The genesis governance anchor for a registry. `admin` is the immutable
-- instrument root party (equals `SimpleTokenRules.admin`). One instance per
-- registry by convention; nothing depends on uniqueness, because every consumer
-- validates the full capability tuple via `requireRole`.
template TokenAdministrator
  with
    admin : Party  -- ^ The registry root party (== SimpleTokenRules.admin), fixed.
  where
    signatory admin

    -- | Root issues a capability directly. Nonconsuming so the root can issue
    -- unboundedly without churning the anchor.
    --
    -- # Invariants enforced:
    -- - INV-31: only the root admin can create capabilities here (controller + signatory)
    nonconsuming choice Admin_IssueRole : ContractId RoleCapability
      with
        assignee : Party                -- ^ Party to receive the role.
        role : Role                     -- ^ Role to grant.
        scope : Optional InstrumentId   -- ^ None = registry-wide; Some = single instrument.
      controller admin
      do create RoleCapability with admin; assignee; role; scope

    -- | Root revokes a capability by archiving it.
    --
    -- # Invariants enforced:
    -- - INV-32: a revoked capability is inactive; later `requireRole` fails (NotActive)
    nonconsuming choice Admin_RevokeRole : ()
      with capCid : ContractId RoleCapability  -- ^ Capability to revoke.
      controller admin
      do
        cap <- fetch capCid
        assertMsg eCapabilityNotIssuedByThisAdmin (cap.admin == admin)
        archive capCid

    -- | Delegated issuance: a holder of a registry-wide `Admin` capability mints
    -- a further capability. This is the ownership-handoff mechanism — grant a
    -- governance party an `Admin` capability and it can administer the registry
    -- immediately; revoke it to hand control back. The new capability is
    -- admin-signed because the choice runs with this contract's admin authority.
    --
    -- # Invariants enforced:
    -- - INV-31: caller must hold a registry-wide `Admin` capability
    nonconsuming choice Admin_DelegatedIssueRole : ContractId RoleCapability
      with
        caller : Party                       -- ^ The delegate exercising the choice.
        adminCap : ContractId RoleCapability  -- ^ The caller's Admin capability.
        assignee : Party                      -- ^ Party to receive the role.
        role : Role                           -- ^ Role to grant.
        scope : Optional InstrumentId         -- ^ None = registry-wide; Some = single instrument.
      controller caller
      do
        requireRole caller Admin admin None adminCap
        create RoleCapability with admin; assignee; role; scope

    -- | Delegated revocation: a registry-wide `Admin` capability holder revokes a
    -- capability issued by this registry.
    --
    -- # Invariants enforced:
    -- - INV-31: caller must hold a registry-wide `Admin` capability
    -- - INV-32: revoked capability becomes inactive
    nonconsuming choice Admin_DelegatedRevokeRole : ()
      with
        caller : Party                        -- ^ The delegate exercising the choice.
        adminCap : ContractId RoleCapability  -- ^ The caller's Admin capability.
        capCid : ContractId RoleCapability    -- ^ Capability to revoke.
      controller caller
      do
        requireRole caller Admin admin None adminCap
        cap <- fetch capCid
        assertMsg eCapabilityNotIssuedByThisAdmin (cap.admin == admin)
        archive capCid
