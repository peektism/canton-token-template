-- | Ownable-as-Admin-role: the governance anchor for a registry.
--
-- Design (docs/ADMIN-LAYER-PLAN.md §5): on Canton the instrument `admin` party is
-- baked into every `InstrumentId` and co-signs every holding, so it is the
-- permanent cryptographic root and cannot be reassigned without re-issuing
-- assets. Rather than fake an "ownership transfer" of that party, the admin
-- layer collapses Ownable into AccessControl: the `Admin` role *is* the owner
-- (`DEFAULT_ADMIN_ROLE`). The genesis `admin` party always retains ultimate
-- authority; operational governance is delegated by issuing an `Admin`
-- capability to another party and revoked by archiving it. That delegation —
-- not a party swap — is the ownership-handoff analogue, and it works
-- immediately because every capability is anchored to the same fixed `admin`.
--
-- `TokenAdministrator` is the genesis issuer. It exposes direct issuance/
-- revocation (controlled by the root `admin`) and delegated issuance/revocation
-- (controlled by any holder of a registry-wide `Admin` capability). Delegated
-- choices carry the contract's admin authority, so a delegate can mint/revoke
-- admin-signed capabilities without holding the root key.
module SimpleToken.Admin.Authority where

import DA.Time (RelTime, addRelTime)

import Splice.Api.Token.HoldingV1 (InstrumentId, Holding)
import Splice.Api.Token.MetadataV1 (emptyMetadata)

import qualified OpenZeppelin.AccessControl as AC

import SimpleToken.Holding (SimpleHolding, SimpleHolding_ForcedSeize(..))
import SimpleToken.Preapproval (TransferPreapproval, TransferPreapproval_ReceiveSeized(..))
import SimpleToken.Admin.Capability (RoleCapability(..), requireRole)
import SimpleToken.Admin.Errors
import SimpleToken.Admin.Roles (Role(..), roleAdmin, delegableViaRoleAdmin)

-- | Mint a capability anchored to this registry. Shared by root and delegated
-- issuance so the create site is single-sourced.
mkRoleCapability : Party -> Party -> Role -> Optional InstrumentId -> Update (ContractId RoleCapability)
mkRoleCapability admin assignee role scope =
  create RoleCapability with admin; assignee; role; scope; mintAllowance = None

-- | Fetch a capability and assert it was issued by this registry, returning the
-- authoritative on-ledger record. Shared by the root and the delegated revoke
-- paths so the issued-by-this-admin check cannot drift. It deliberately fetches
-- (rather than trusting a caller-supplied record) so the value it checks is the
-- value the caller then archives by the same `capCid` — sound by construction.
-- The caller archives after this returns; the delegated path also reuses the
-- returned `.role` for its role-admin gate, so neither path fetches twice. The
-- *role policy* differs per path: the root may revoke any role; a delegate must
-- first pass `requireRoleAdmin` (which enforces the `Admin`-is-root-managed
-- carve-out).
requireIssuedByThisAdmin : Party -> ContractId RoleCapability -> Update RoleCapability
requireIssuedByThisAdmin admin capCid = do
  cap <- fetch capCid
  assertMsg eCapabilityNotIssuedByThisAdmin (cap.admin == admin)
  pure cap

-- | The single chokepoint for the delegated role-admin path (AL-8). Asserts, in
-- one place shared by the delegated issue and revoke choices (and any future
-- delegated choice), that:
--   1. `role` is delegable at all — the `Admin`/`DEFAULT_ADMIN_ROLE` is
--      root-managed and rejected here (`delegableViaRoleAdmin`, the single-source
--      carve-out in `SimpleToken.Admin.Roles`; the `AccessControlDefaultAdminRules`
--      posture, decision C9); and
--   2. `caller` holds the admin role of `role` (its `roleAdmin`), registry-wide.
-- The required admin role is computed from the compiled `roleAdmin` relation; the
-- admin/assignee/role checks (A1–A3) are delegated to the `oz-access-control`
-- library via `Capability.requireRole`. Folding the carve-out into this one gate
-- (rather than a `role /= Admin` literal repeated at each choice) means the policy
-- cannot drift between paths or be forgotten by a new delegated choice. Returns the
-- validated admin capability (callers discard it).
requireRoleAdmin : Party -> Party -> Role -> ContractId RoleCapability -> Update RoleCapability
requireRoleAdmin caller admin role adminCap = do
  assertMsg eDefaultAdminRoleRootManaged (delegableViaRoleAdmin role)
  requireRole caller (roleAdmin role) admin None adminCap

-- | The genesis governance anchor for a registry. `admin` is the immutable
-- instrument root party (equals `SimpleTokenRules.admin`). One instance per
-- registry by convention; nothing depends on uniqueness, because every consumer
-- validates the full capability tuple via `requireRole`.
template TokenAdministrator
  with
    admin : Party  -- ^ The registry root party (== SimpleTokenRules.admin), fixed.
  where
    signatory admin

    -- | Root issues a capability directly. Nonconsuming so the root can issue
    -- unboundedly without churning the anchor.
    --
    -- # Invariants enforced:
    -- - INV-31: only the root admin can create capabilities here (controller + signatory)
    nonconsuming choice Admin_IssueRole : ContractId RoleCapability
      with
        assignee : Party                -- ^ Party to receive the role.
        role : Role                     -- ^ Role to grant (the root may grant any role, incl. Admin).
        scope : Optional InstrumentId   -- ^ None = registry-wide; Some = single instrument.
      controller admin
      do mkRoleCapability admin assignee role scope

    -- | Root issues a capped `Minter` capability with a D3 mint allowance.
    -- (`Admin_IssueRole … Minter` issues an *unlimited* minter, `mintAllowance =
    -- None`; this choice issues a *bounded* one.) Minter is root-managed, so this
    -- lives only on the root anchor, controlled by `admin`.
    --
    -- # Invariants enforced:
    -- - INV-36: a capped allowance is non-negative (also enforced by RoleCapability `ensure`)
    nonconsuming choice Admin_IssueCappedMinter : ContractId RoleCapability
      with
        assignee : Party                -- ^ Party to receive the Minter capability.
        scope : Optional InstrumentId   -- ^ None = registry-wide; Some = single instrument.
        allowance : Decimal             -- ^ Initial remaining mint allowance.
      controller admin
      do
        assertMsg eMintAllowanceNegative (allowance >= 0.0)
        create RoleCapability with
          admin; assignee; role = Minter; scope; mintAllowance = Some allowance

    -- | Root revokes a capability by archiving it (any role, including Admin).
    --
    -- # Invariants enforced:
    -- - INV-32: a revoked capability is inactive; later `requireRole` fails (NotActive)
    nonconsuming choice Admin_RevokeRole : ()
      with capCid : ContractId RoleCapability  -- ^ Capability to revoke.
      controller admin
      do
        _ <- requireIssuedByThisAdmin admin capCid
        archive capCid

    -- | Delegated issuance (AL-8, role-admin-aware): a holder of the **admin role
    -- of `role`** (`roleAdmin role`, registry-wide) mints a capability for `role`.
    -- With the flat default (`roleAdmin _ = Admin`) any `Admin` holder may delegate
    -- every operational role — matching OZ `AccessControl` breadth. The new
    -- capability is admin-signed because the choice runs with this contract's
    -- admin authority, so a delegate appoints roles without holding the root key.
    --
    -- `Admin` itself is **not** issuable here (the `AccessControlDefaultAdminRules`
    -- posture, decision C9): re-delegating root would let a delegate mint another
    -- root. The genesis root issues `Admin` via `Admin_IssueRole`, and the
    -- two-step + timelocked `Admin_BeginDefaultAdminTransfer` is the safe handoff.
    -- Both the root-role carve-out and the admin/assignee/role/scope gate are
    -- enforced by the single `requireRoleAdmin` chokepoint. See
    -- docs/ADMIN-LAYER-PLAN.md §5.
    --
    -- # Invariants enforced:
    -- - INV-31: caller must hold the registry-wide admin role of `role`; `Admin` is never delegable here (both via `requireRoleAdmin`)
    nonconsuming choice Admin_DelegatedIssueRole : ContractId RoleCapability
      with
        caller : Party                       -- ^ The delegate exercising the choice.
        adminCap : ContractId RoleCapability  -- ^ The caller's capability for `roleAdmin role`.
        assignee : Party                      -- ^ Party to receive the role.
        role : Role                           -- ^ Role to grant (not `Admin`).
        scope : Optional InstrumentId         -- ^ None = registry-wide; Some = single instrument.
      controller caller
      do
        _ <- requireRoleAdmin caller admin role adminCap
        mkRoleCapability admin assignee role scope

    -- | Delegated revocation (AL-8, role-admin-aware): a holder of the admin role
    -- of the revoked capability's role revokes it. Delegates can manage every role
    -- administered by a role they hold — shared operational-role management —
    -- but never `Admin` (root-managed; see `Admin_DelegatedIssueRole`). The genesis
    -- root remains the sole governance authority and always recovers via the
    -- un-revocable `TokenAdministrator`.
    --
    -- # Invariants enforced:
    -- - INV-31: caller must hold the registry-wide admin role of the revoked role; `Admin` is never revocable here (both via `requireRoleAdmin`)
    -- - INV-32: revoked capability becomes inactive
    nonconsuming choice Admin_DelegatedRevokeRole : ()
      with
        caller : Party                        -- ^ The delegate exercising the choice.
        adminCap : ContractId RoleCapability  -- ^ The caller's capability for the target role's admin.
        capCid : ContractId RoleCapability    -- ^ Capability to revoke (not an `Admin` capability).
      controller caller
      do
        target <- requireIssuedByThisAdmin admin capCid
        _ <- requireRoleAdmin caller admin target.role adminCap
        archive capCid

    -- | Begin a two-step, timelocked handoff of the `Admin`/`DEFAULT_ADMIN_ROLE`
    -- to `newAdmin` — the `AccessControlDefaultAdminRules` analogue and the only
    -- delegated route to the otherwise root-managed `Admin` role (decision C9).
    -- The root sets a `delay`; `newAdmin` cannot accept before it elapses, and the
    -- root may cancel within the window. On acceptance `newAdmin` receives a
    -- registry-wide `Admin` capability (it does NOT revoke any existing `Admin`
    -- holder — the root revokes the prior holder separately if exclusive handoff
    -- is wanted, and always retains ultimate authority via this anchor).
    --
    -- # Invariants enforced:
    -- - INV-31: only the genesis root initiates a default-admin handoff; nominee must differ from the root
    nonconsuming choice Admin_BeginDefaultAdminTransfer : ContractId PendingDefaultAdminTransfer
      with
        newAdmin : Party    -- ^ The nominee who must accept after the timelock.
        delay : RelTime     -- ^ How long after now the nominee may accept.
      controller admin
      do
        assertMsg AC.eDefaultAdminSameParty (newAdmin /= admin)
        now <- getTime
        create PendingDefaultAdminTransfer with
          admin; newAdmin; effectiveTime = addRelTime now delay

    -- | Propose a forced seizure of `targetHoldingCid`, reallocating its value to
    -- `newOwner` (AL-11). Step ONE of the two-person control (AL-9 OQ-2): the
    -- proposer presents a `LegalAdmin` capability in scope for the holding's
    -- instrument; a DIFFERENT `LegalAdmin` must later approve via
    -- `SeizureProposal_Approve` for the seizure to take effect — no single officer
    -- can both propose and approve an irreversible deprivation of property. The
    -- holding's owner/amount/instrument are captured now for the immutable audit
    -- record (no re-validation is needed at approval: `targetHoldingCid` is an
    -- immutable contract id, so if the owner moved/burned it the cid is stale and the
    -- approve's `SimpleHolding_ForcedSeize` fails `NotActive`). The choice runs with
    -- this anchor's admin authority, so the created `SeizureProposal` is admin-signed
    -- (it later carries the authority to archive the seized holding); the proposer is
    -- only an observer, exactly as a `LegalAdmin` delegate holds a capability, not the
    -- root key.
    --
    -- # Invariants enforced:
    -- - INV-43: proposing a seizure requires a LegalAdmin capability (step 1 of 2);
    --   the proposer may not be the seizure beneficiary (separation of duties)
    nonconsuming choice Admin_ProposeSeizure : ContractId SeizureProposal
      with
        proposer : Party                            -- ^ The LegalAdmin proposing the seizure.
        proposerLegalCap : ContractId RoleCapability -- ^ The proposer's LegalAdmin capability.
        targetHoldingCid : ContractId SimpleHolding -- ^ The holding to seize.
        newOwner : Party                            -- ^ The recovery destination (must be preapproved at approval).
        reason : Text                               -- ^ Audit metadata (court-order reference, ticket, etc.).
      controller proposer
      do
        holding <- fetch targetHoldingCid
        assertMsg eSeizureForeignHolding (holding.admin == admin)
        -- Separation of duties: an officer cannot propose a seizure into their own
        -- account (the approver is barred too, at approval).
        assertMsg eSeizureBeneficiaryIsOfficer (newOwner /= proposer)
        _ <- requireRole proposer LegalAdmin admin (Some holding.instrumentId) proposerLegalCap
        create SeizureProposal with
          admin
          proposer
          targetHoldingCid
          seizedOwner = holding.owner
          amount = holding.amount
          instrumentId = holding.instrumentId
          newOwner
          reason

-- | A pending two-person forced seizure (AL-11) — the seize-and-reallocate analogue
-- of the AL-6 forced *burn*, but value-preserving. Created by `Admin_ProposeSeizure`
-- (step 1, by one `LegalAdmin`) and finalized by `SeizureProposal_Approve` (step 2,
-- by a DIFFERENT `LegalAdmin`). The separation of duties (AL-9 OQ-2) guards the
-- irreversible deprivation of property: no single officer can seize. It is the
-- counterpart to AL-10's single-officer, reversible freeze.
--
-- Signatories: admin (so the approve can archive the admin-co-signed holding and
--   reallocate via a preapproval). Observers: proposer (so they can cancel / track).
-- Disclosed parties: the approving LegalAdmin (a non-stakeholder) acts via explicit
--   disclosure — the off-ledger service provides it, exactly as for delegated revoke.
-- Manual-only (AL-9 OQ-2): every step is a human-exercised choice; nothing fires
--   automatically. The `reason` is carried into the (consuming) approve transaction
--   as an immutable on-ledger audit trail.
template SeizureProposal
  with
    admin : Party
    proposer : Party                            -- ^ The LegalAdmin who proposed (cannot also approve).
    targetHoldingCid : ContractId SimpleHolding -- ^ The holding to seize.
    seizedOwner : Party                         -- ^ The owner seized from, captured at propose for the immutable audit record (not re-validated — cid immutability already forces a re-propose if the holding moved).
    amount : Decimal                            -- ^ The amount, captured at propose.
    instrumentId : InstrumentId                 -- ^ The instrument, captured at propose.
    newOwner : Party                            -- ^ The reallocation destination.
    reason : Text                               -- ^ Audit metadata.
  where
    signatory admin
    observer proposer

    -- | Approve and execute the seizure (step 2). The approver must be a DIFFERENT
    -- `LegalAdmin` than the proposer (two-person control). Archives the target holding
    -- (`SimpleHolding_ForcedSeize`) and reallocates an EQUAL holding to `newOwner` via
    -- `newOwner`'s `TransferPreapproval` (creating a holding needs the new owner's
    -- authority — the recovery/custody destination must be onboarded, exactly as any
    -- transfer recipient). The seized `amount`/`instrumentId` were captured at propose
    -- from the same (immutable) holding cid, so net supply is unchanged (one holding
    -- archived, an equal one created). The approver must supply `newOwner`'s OWN
    -- preapproval, so they cannot redirect the seized value to a different party.
    --
    -- If the owner moved/split/burned the holding between propose and approve, its cid
    -- is stale and `SimpleHolding_ForcedSeize` fails (`NotActive`) — the seizure must
    -- be re-proposed against the current holding (a seizure cannot be made race-free
    -- against a still-consenting owner; see `SimpleHolding_ForcedBurn`).
    --
    -- # Invariants enforced:
    -- - INV-43: approval requires a LegalAdmin capability, `approver /= proposer`
    --   (two-person), and neither officer is the beneficiary (separation of duties)
    -- - INV-44: value preserved — an equal amount/instrument is reallocated to the proposed `newOwner`
    choice SeizureProposal_Approve : ContractId Holding
      with
        approver : Party                              -- ^ A second LegalAdmin (≠ proposer).
        approverLegalCap : ContractId RoleCapability  -- ^ The approver's LegalAdmin capability.
        newOwnerPreapprovalCid : ContractId TransferPreapproval -- ^ newOwner's preapproval (carries their authority to receive).
      controller approver
      do
        assertMsg eSeizureRequiresTwoOfficers (approver /= proposer)
        -- Separation of duties: neither officer may be the beneficiary, so an
        -- approver cannot approve a seizure into their own (or the proposer's)
        -- account. (`newOwner /= proposer` was also checked at propose.)
        assertMsg eSeizureBeneficiaryIsOfficer (newOwner /= approver && newOwner /= proposer)
        _ <- requireRole approver LegalAdmin admin (Some instrumentId) approverLegalCap
        preapproval <- fetch newOwnerPreapprovalCid
        assertMsg eSeizureNewOwnerMismatch
          (preapproval.admin == admin && preapproval.receiver == newOwner)
        -- Archive the seized holding (consuming choice on it; admin authority present;
        -- fails NotActive if the owner already moved it — re-propose).
        exercise targetHoldingCid SimpleHolding_ForcedSeize
        -- Reallocate an equal holding to newOwner via their preapproval.
        exercise newOwnerPreapprovalCid TransferPreapproval_ReceiveSeized with
          seizedInstrumentId = instrumentId
          amount
          holdingMeta = emptyMetadata

    -- | Cancel an unexecuted seizure proposal (the proposer withdraws it).
    choice SeizureProposal_Cancel : ()
      controller proposer
      do pure ()

-- | A pending, timelocked transfer of the `Admin`/`DEFAULT_ADMIN_ROLE` to
-- `newAdmin` — the token's `AccessControlDefaultAdminRules` handoff. It mirrors
-- the generic `oz-access-control` `DefaultAdminTransferOffer` (offer → accept,
-- with cancel + a ledger-time gate) but creates the token's richer
-- `RoleCapability` on acceptance rather than the library's minimal `RoleGrant`
-- (the AL-7 finding: reuse the library's *logic* — here its `requireTimelockElapsed`
-- gate and error — not its storage, since templates are monomorphic).
--
-- Signatories: admin. Observers: newAdmin (must see the pending handoff to
--   accept). Controllers: newAdmin accepts; admin cancels.
-- Choices: PendingDefaultAdminTransfer_Accept, PendingDefaultAdminTransfer_Cancel.
-- Disclosed parties: admin and newAdmin are stakeholders.
-- Privacy expectations: limited to the two parties to the handshake.
-- Authorization assumptions: only newAdmin may accept (root never lands on a
--   party that has not claimed it); only admin (the genesis root) may cancel.
-- Archival behavior: both choices consuming; accept creates the Admin capability,
--   cancel creates nothing.
-- Failure modes: accepting before effectiveTime fails (eDefaultAdminTimelockNotElapsed).
-- Upgrade and migration assumptions: 0.x; reconfiguration is a package upgrade.
template PendingDefaultAdminTransfer
  with
    admin : Party          -- ^ The genesis root initiating the handoff.
    newAdmin : Party       -- ^ The nominee who must accept after the timelock.
    effectiveTime : Time   -- ^ Earliest ledger time the nominee may accept.
  where
    signatory admin
    observer newAdmin

    -- | Accept the handoff once the timelock elapses; grants `newAdmin` a
    -- registry-wide `Admin` capability. The time gate is delegated to the
    -- `oz-access-control` library's `requireTimelockElapsed`.
    choice PendingDefaultAdminTransfer_Accept : ContractId RoleCapability
      controller newAdmin
      do
        AC.requireTimelockElapsed effectiveTime
        mkRoleCapability admin newAdmin Admin None

    -- | Cancel the pending handoff before acceptance (root only).
    choice PendingDefaultAdminTransfer_Cancel : ()
      controller admin
      do pure ()
