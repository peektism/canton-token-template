-- | Experimental CIP-0112 account probe.
-- This is a non-release adapter over the real preview V2 Account type.
module SimpleToken.Experimental.Cip112.Account where

import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.TokenStandard.Utils qualified as TokenStandard

-- | Preview V2 Account type from Splice.
-- Do not use this module as a stable public API or as a conformance claim.
type Account = HoldingV2.Account

-- | CIP-0112-style account equivalent to a V1 owner Party.
basicAccount : Party -> Account
basicAccount = TokenStandard.basicAccount

-- | True when an account has no provider and no account id.
isBasicAccount : Account -> Bool
isBasicAccount = TokenStandard.isBasicAccount

-- | CIP-0112-style regular account managed by a provider.
-- This prototype treats the provider as the movement authority and the owner
-- as an observer/principal. It is not a custody-provider implementation.
providerManagedAccount : Party -> Party -> Text -> Account
providerManagedAccount owner provider accountId =
  HoldingV2.Account with
    owner = Some owner
    provider = Some provider
    id = accountId

-- | Exact marker used when a flow expected either a V1-equivalent basic
-- account or this slice's regular provider-managed account shape.
supportedRegularAccountFailureMsg : Text
supportedRegularAccountFailureMsg =
  "SimpleToken V2 account must be either basic or provider-managed regular account"

-- | Preview shape validation: regular accounts must have an owner; special
-- mint/burn-style accounts must have a non-empty id.
isValidAccountShape : Account -> Bool
isValidAccountShape account =
  case account.owner of
    Some _ -> True
    None -> account.id /= ""

-- | This slice supports regular provider-managed accounts only when both the
-- owner and provider are present and the provider-managed account has an
-- explicit non-empty id.
isProviderManagedRegularAccount : Account -> Bool
isProviderManagedRegularAccount account =
  case (account.owner, account.provider) of
    (Some _owner, Some _provider) -> account.id /= ""
    _ -> False

-- | Supported account shapes for this experimental slice.
isSupportedRegularAccount : Account -> Bool
isSupportedRegularAccount account =
  isBasicAccount account || isProviderManagedRegularAccount account

assertSupportedRegularAccount : Text -> Account -> Update ()
assertSupportedRegularAccount fieldName account =
  assertMsg (supportedRegularAccountFailureMsg <> " for " <> fieldName)
    (isSupportedRegularAccount account)

regularAccountOwner : Account -> Party
regularAccountOwner account = case account.owner of
  Some owner -> owner
  None -> error $ "Expected a regular account owner, got: " <> show account

regularAccountProvider : Account -> Party
regularAccountProvider account = case account.provider of
  Some provider -> provider
  None -> error $ "Expected a provider-managed account provider, got: " <> show account

-- | The party that acts for the account in this prototype: owner for basic
-- accounts, provider for provider-managed regular accounts.
accountAuthority : Party -> Account -> Party
accountAuthority admin account =
  if isProviderManagedRegularAccount account
    then regularAccountProvider account
    else TokenStandard.accountPrincipal admin account

-- | The account principal used for V1-style owner reasoning and docs.
accountPrincipal : Party -> Account -> Party
accountPrincipal = TokenStandard.accountPrincipal

-- | Parties that must be able to observe regular account movements.
-- The full V2 authorization split remains intentionally unresolved here.
accountObservers : Account -> [Party]
accountObservers = TokenStandard.regularAccountParties
